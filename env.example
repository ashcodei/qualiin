# Copy this file to .env (in backend/ or project root) and fill in values. Do not commit .env.

# --- Auth ---
SECRET_KEY=
# Optional: create a default admin if no users exist (set both)
LOGIN_USER=
LOGIN_PASSWORD=

# --- Database (leave empty for SQLite; set for PostgreSQL) ---
DATABASE_URL=

# --- Redis (Celery broker + highlight cache; leave empty for in-memory cache, no Celery) ---
REDIS_URL=
# Optional: default is REDIS_URL
CELERY_BROKER_URL=

# Use Celery for PDF jobs (1) or in-process thread pool (0). Default 1.
USE_CELERY=1

# --- Storage (local = default; set s3 + AWS_* for S3) ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=
S3_PREFIX=

# --- Optional: Ollama LLM (typo context check) ---
# OLLAMA_ENABLED=
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT=5
# OLLAMA_MAX_TOKENS=10

# --- Optional: limits and production ---
# MAX_UPLOAD_MB=100
# USE_SECURE_SESSION_COOKIES=0
